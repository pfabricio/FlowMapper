<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FlowMapper</RootNamespace>
    <PackageId>FlowMapper</PackageId>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <Title>FlowMapper V2</Title>
    <Description>All-in-one meta-package: compile-time object mapper, micro-ORM, source generator, DI integration, and database providers (SQL Server, PostgreSQL, MySQL, Oracle)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowMapper.Abstractions\FlowMapper.Abstractions.csproj" />
    <ProjectReference Include="..\FlowMapper.Primitives\FlowMapper.Primitives.csproj" />
    <ProjectReference Include="..\FlowMapper.Core\FlowMapper.Core.csproj" />
    <ProjectReference Include="..\FlowMapper.Execution\FlowMapper.Execution.csproj" />
    <ProjectReference Include="..\FlowMapper.Materializer\FlowMapper.Materializer.csproj" />
    <ProjectReference Include="..\FlowMapper.Providers.Abstractions\FlowMapper.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\FlowMapper.Providers.SqlServer\FlowMapper.Providers.SqlServer.csproj" />
    <ProjectReference Include="..\FlowMapper.Providers.PostgreSql\FlowMapper.Providers.PostgreSql.csproj" />
    <ProjectReference Include="..\FlowMapper.Providers.MySql\FlowMapper.Providers.MySql.csproj" />
    <ProjectReference Include="..\FlowMapper.Providers.Oracle\FlowMapper.Providers.Oracle.csproj" />
    <ProjectReference Include="..\FlowMapper.Compiler\FlowMapper.Compiler.csproj" />
    <ProjectReference Include="..\FlowMapper.Runtime\FlowMapper.Runtime.csproj" />
    <ProjectReference Include="..\FlowMapper.Diagnostics\FlowMapper.Diagnostics.csproj" />
    <ProjectReference Include="..\FlowMapper.Deserialization\FlowMapper.Deserialization.csproj" />
    <ProjectReference Include="..\FlowMapper.DependencyInjection\FlowMapper.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowMapper.SourceGenerator\FlowMapper.SourceGenerator.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" />
    <None Include="..\FlowMapper.SourceGenerator\bin\$(Configuration)\netstandard2.0\FlowMapper.SourceGenerator.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" Visible="false" />
  </ItemGroup>
</Project>
