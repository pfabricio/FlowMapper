<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FlowMapper.SourceGenerator</id>
    <version>1.0.0</version>
    <authors>FlowMapper</authors>
