<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>Paulo Fabricio</Authors>
    <Company>DevSpace</Company>
    <Product>FlowMapper V2</Product>
    <Description>Compile-time object mapper and data access micro-ORM with zero runtime reflection</Description>
    <Copyright>Copyright FlowMapper</Copyright>
    <PackageProjectUrl>https://github.com/pfabricio/FlowMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anomalyco/FlowMapper.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mapper;orm;micro-orm;source-generator;roslyn;data-access;object-mapper</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
